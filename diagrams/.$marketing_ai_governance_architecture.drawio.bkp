        <mxCell id="e15" value="feedback (learning)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="human" target="gen"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1265" y="680"/><mxPoint x="850" y="680"/></Array></mxGeometry></mxCell>
        <mxCell id="e16" value="send" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="delivery" target="whatsapp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1265" y="180"/><mxPoint x="220" y="180"/></Array></mxGeometry></mxCell>
