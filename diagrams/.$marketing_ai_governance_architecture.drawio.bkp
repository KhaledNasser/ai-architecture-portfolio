        <mxCell id="e18" value="identifiable" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;exitX=0.25;exitY=1;" edge="1" parent="1" source="gen" target="selfllm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="creative" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=1;" edge="1" parent="1" source="gen" target="mask"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="masked only" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#5E35B1;" edge="1" parent="1" source="mask" target="extllm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e21" value="retrieve" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;startArrow=block;" edge="1" parent="1" source="selfllm" target="analytics"><mxGeometry relative="1" as="geometry"/></mxCell>
