        <mxCell id="e11" value="score" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="score" target="decision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontStyle=1;fontColor=#2E7D32;" edge="1" parent="1" source="decision" target="delivery"><mxGeometry relative="1" as="geometry"/></mxCell>
